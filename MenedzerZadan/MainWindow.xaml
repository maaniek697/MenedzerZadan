<Window x:Class="MenedzerZadan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MenedzerZadan"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
        <StackPanel Margin="20">
                <TextBlock Text="Moja Lista Zadań" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <DockPanel Margin="0,0,0,10">
                        <Button x:Name="BtnDodaj" 
                                Content="Dodaj" 
                                Width="80" 
                                DockPanel.Dock="Right" 
                                Margin="10,0,0,0"
                                Click="BtnDodaj_Click"/>
                        <TextBox x:Name="TxtZadanie" 
                                 FontSize="16" 
                                 VerticalContentAlignment="Center"
                                 KeyDown="TxtZadanie_KeyDown"/>
                </DockPanel>

                <ListBox x:Name="ListaZadan" 
                         Height="200" 
                         FontSize="14"
                         KeyDown="ListaZadan_KeyDown"/>
    
                <Button x:Name="BtnUsun" 
                        Content="Usuń zaznaczone" 
                        Margin="0,10,0,0" 
                        Background="#FFE57373"
                        Click="BtnUsun_Click"/>
        </StackPanel>
</Window>
